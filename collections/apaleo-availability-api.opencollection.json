{
  "opencollection": "1.0.0",
  "info": {
    "name": "apaleo Platform Availability API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://identity.apaleo.com/connect/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Availability",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Return unit availability for a property and date range.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.apaleo.com/availability/v1/units",
            "params": [
              {
                "name": "propertyId",
                "value": "",
                "type": "query"
              },
              {
                "name": "from",
                "value": "",
                "type": "query"
              },
              {
                "name": "to",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Return unit availability for a property and date range."
        },
        {
          "info": {
            "name": "Return unit-group availability for a property and date range.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.apaleo.com/availability/v1/unit-groups",
            "params": [
              {
                "name": "propertyId",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Return unit-group availability for a property and date range."
        },
        {
          "info": {
            "name": "Return service availability for a property and date range.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.apaleo.com/availability/v1/services"
          },
          "docs": "Return service availability for a property and date range."
        }
      ]
    }
  ],
  "bundled": true
}